FROM python:3.12.14-slim
RUN apt-get update && apt-get install -y --no-install-recommends --only-upgrade \
    apt ca-certificates libapt-pkg7.0 libc-bin libc6 liblzma5 libpcre2-8-0 \
    libssl3t64 openssl openssl-provider-legacy zlib1g \
    && mkdir -p /usr/local/share/orderflow \
    && dpkg-query -W > /usr/local/share/orderflow/os-packages.txt \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src ODF_DBT_EXECUTABLE=/opt/dbt/bin/dbt
COPY requirements.lock warehouse/requirements-dbt.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements.lock && python -m venv /opt/dbt && /opt/dbt/bin/pip install --no-cache-dir --require-hashes -r requirements-dbt.lock
COPY . .
RUN useradd --uid 10001 --create-home app && chown -R app:app /app
USER app
ENTRYPOINT ["python","scripts/pipeline.py"]

