{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm --prefix dashboard ci && npm --prefix dashboard run build",
  "functions": {
    "**/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{.env*,.runtime/**,.venv*/**,node_modules/**,dashboard/node_modules/**,tests/**,artifacts/**,work/**,analysis/**,orchestration/**,scripts/**,.git/**,docs/**,*.zip,*.mp4,*.webm}"
    }
  },
  "crons": [{"path": "/_internal/outbox", "schedule": "0 4 * * *"}]
}
