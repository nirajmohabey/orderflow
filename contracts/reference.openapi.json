{
  "openapi": "3.1.0",
  "info": {
    "title": "OrderFlow operator and ingestion API",
    "version": "0.1.0-design",
    "description": "Proposed first-release contract. Source keys map to one tenant and source. Operator JWTs map to one tenant and role. Implementations must enforce these mappings. All identifiers in paths remain tenant scoped."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Proposed local service"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthCheck",
        "security": [],
        "summary": "Process health without tenant data",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/sources/{source_id}/events": {
      "post": {
        "operationId": "ingestEvent",
        "summary": "Durably accept one source event",
        "description": "Return 202 only after inbox commit. Same source event ID and canonical envelope returns the stable original event ID, duplicate true, and its current processing status; the body need not equal the original pending response. Changed envelope under the same ID is 409. Source credential tenant must match envelope tenant.",
        "security": [
          {
            "SourceKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SourceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventEnvelope"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durably accepted or identical replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Acceptance"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "Source event identity reused with changed content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Payload exceeds configured request limit"
          },
          "422": {
            "description": "Invalid envelope or entity payload structure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Acceptance unavailable or commit outcome unknown; retry with the same identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/{event_id}": {
      "get": {
        "operationId": "getEventStatus",
        "summary": "Inspect an event within the authenticated tenant",
        "parameters": [
          {
            "$ref": "#/components/parameters/EventId"
          }
        ],
        "responses": {
          "200": {
            "description": "Event status with safe metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventStatus"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/events/{event_id}/retry": {
      "post": {
        "operationId": "expediteRetry",
        "summary": "Expedite an eligible transient retry",
        "description": "Operator role required. Only retry_wait events without a terminal receipt may be expedited. This endpoint cannot reopen completed/quarantined events or change source content. The mutation and audit write commit together.",
        "parameters": [
          {
            "$ref": "#/components/parameters/EventId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Retry scheduling updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "event_id",
                    "status"
                  ],
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "const": "pending"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Event is not eligible for a retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sources/{source_id}/status": {
      "get": {
        "operationId": "getSourceStatus",
        "summary": "Read source health and progress",
        "parameters": [
          {
            "$ref": "#/components/parameters/SourceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Health within the authenticated tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceStatus"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/runs/{run_id}": {
      "get": {
        "operationId": "getRun",
        "summary": "Read a source interval run and its check states",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Run metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/quarantines": {
      "get": {
        "operationId": "listQuarantines",
        "summary": "List redacted terminal failures",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant-scoped page with opaque keyset cursor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "next_cursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Quarantine"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Verified tenant viewer/operator token; route-level role authorization remains required."
      },
      "SourceKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Source-Key",
        "description": "Opaque hashed-at-rest key bound to exactly one tenant and source."
      }
    },
    "parameters": {
      "SourceId": {
        "name": "source_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "EventId": {
        "name": "event_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid credentials",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Credential does not authorize this source, tenant or action",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found within the authenticated tenant; do not reveal another tenant's resource",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "EventEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenant_id",
          "source_event_id",
          "partition_key",
          "schema_version",
          "entity_type",
          "entity_id",
          "entity_version",
          "effective_at",
          "occurred_at",
          "payload"
        ],
        "properties": {
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "source_event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "partition_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Stable adapter-derived entity partition; server validates the source's partition scheme."
          },
          "schema_version": {
            "const": "1"
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "product",
              "order"
            ]
          },
          "entity_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "entity_version": {
            "type": "integer",
            "minimum": 1
          },
          "effective_at": {
            "type": "string",
            "format": "date-time"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "payload": {
            "type": "object",
            "description": "Product payload requires sku, name, unit_price_minor and currency. Order payload requires customer_id, total_minor, currency and status. JSON shape is checked at ingress; authority, revision consistency and cross-record checks can later quarantine."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "entity_type": {
                  "const": "product"
                }
              },
              "required": [
                "entity_type"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "entity_type": {
                  "const": "order"
                }
              },
              "required": [
                "entity_type"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          }
        ]
      },
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "name",
          "unit_price_minor",
          "currency"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "unit_price_minor": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        }
      },
      "Order": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "customer_id",
          "total_minor",
          "currency",
          "status"
        ],
        "properties": {
          "customer_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "total_minor": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "placed",
              "paid",
              "cancelled",
              "fulfilled"
            ]
          }
        }
      },
      "Acceptance": {
        "type": "object",
        "required": [
          "event_id",
          "duplicate",
          "status"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "duplicate": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "retry_wait",
              "completed",
              "quarantined"
            ]
          }
        }
      },
      "EventStatus": {
        "type": "object",
        "required": [
          "event_id",
          "source_id",
          "status",
          "attempt_count",
          "ingested_at",
          "outcome"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "source_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "retry_wait",
              "completed",
              "quarantined"
            ]
          },
          "attempt_count": {
            "type": "integer",
            "minimum": 0
          },
          "ingested_at": {
            "type": "string",
            "format": "date-time"
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "applied_current",
              "history_only",
              "duplicate_revision",
              "quarantined",
              null
            ]
          },
          "reason_code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SourceStatus": {
        "type": "object",
        "required": [
          "source_id",
          "pending_count",
          "quarantine_count",
          "oldest_pending_at",
          "last_commit_at"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "format": "uuid"
          },
          "pending_count": {
            "type": "integer",
            "minimum": 0
          },
          "quarantine_count": {
            "type": "integer",
            "minimum": 0
          },
          "oldest_pending_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_commit_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_successful_interval_end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Run": {
        "type": "object",
        "required": [
          "run_id",
          "source_id",
          "status",
          "interval_start",
          "interval_end",
          "checks"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "source_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "interval_start": {
            "type": "string",
            "format": "date-time"
          },
          "interval_end": {
            "type": "string",
            "format": "date-time"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pass",
                    "fail",
                    "error"
                  ]
                },
                "observed": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "expected": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        }
      },
      "Quarantine": {
        "type": "object",
        "required": [
          "quarantine_id",
          "event_id",
          "reason_code",
          "created_at",
          "redacted_details"
        ],
        "properties": {
          "quarantine_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "reason_code": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "redacted_details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
